{
  "name": "sitetrack-backend",
  "version": "1.0.0",
  "description": "SiteTrack — Civil Engineering Site Progress Portal API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seedAdmin.ts",
    "seed:engineer": "tsx src/scripts/seedTestEngineer.ts",
    "seed:pm": "tsx src/scripts/seedPmUser.ts",
    "test:email": "tsx src/scripts/testEmailNotification.ts",
    "test:audit": "tsx src/scripts/testAuditAndWindow.ts",
    "test:dpr": "tsx src/scripts/testDprApi.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mongoose",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "bcrypt@6.0.0": true
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  }
}
